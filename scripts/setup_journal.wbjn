# encoding: utf-8
"""Журнал Workbench для ОКОННОГО прогона без расчёта (настройка до Solve).

Запуск (окно Workbench остаётся открытым, Mechanical показывает настроенную модель):

    runwb2 -F "<копия>.wbpj" -R "C:\\Work\\ansys-automation\\scripts\\setup_journal.wbjn"

``-I`` НЕ используется: живой прогон 2026-11-18 показал, что в интерактивном
режиме ``SendCommand`` до Mechanical не доходит (нагрузка не начинала
исполняться). Без ``-I`` команда доставляется. Чтобы модель было чем показать,
журнал в конце сохраняет проект (``Save``) — настроенную копию открывают потом
обычным ``runwb2 -F``.

Что делает: один ``SendCommand`` в Mechanical выполняет
``src/Mechanical/ansys_automation.py`` — контакты, сетка, ГУ/нагрузки, валидация,
объекты результатов. Расчёт **не запускается**: решение живёт в отдельном
``solve_and_export.py``, и здесь оно не вызывается.

Две грабли, найденные живым прогоном 2026-11-18:

* ``execfile`` не выставляет ``__file__`` — без явного присваивания скрипт не
  находит пакет ``Mechanical`` (``ImportError: No module named Mechanical.utils``);
* в GUI-режиме никто не выставляет ``ANSYS_AUTOMATION_ROOT`` / ``STRUCTURE_ID`` /
  ``EXECUTION`` / путь к ``.wbpj`` (в batch это делает ``run_ansys.bat``) —
  выставляем здесь.

Каждый шаг пишется в ``logs\\setup.txt`` и ``logs\\setup-mech.txt`` с немедленным
закрытием файла: упавшее исключение внутри ``SendCommand`` наружу не всплывает,
судить можно только по этим файлам.
"""
SetScriptVersion(Version="21.1.216")

import os
import time

ROOT = r"C:\Work\ansys-automation"
OUT = os.path.join(ROOT, "logs", "setup.txt")
MECH = os.path.join(ROOT, "logs", "setup-mech.txt")

# Окружение конвейера: в GUI-режиме его никто не готовит.
os.environ["ANSYS_AUTOMATION_ROOT"] = ROOT
os.environ["STRUCTURE_ID"] = "8946"
os.environ["EXECUTION"] = "08"
try:
    project_file = GetProjectFile()
except Exception:
    project_file = None
if project_file:
    os.environ["ANSYS_AUTOMATION_PROJECT"] = "%s" % project_file


def w(path, text):
    handle = open(path, "a")
    try:
        handle.write(text + "\n")
    finally:
        handle.close()


if os.path.exists(OUT):
    os.remove(OUT)
if os.path.exists(MECH):
    os.remove(MECH)

w(OUT, "journal start")
w(OUT, "project file: %s" % os.environ.get("ANSYS_AUTOMATION_PROJECT"))
system1 = GetSystem(Name="SYS")
model1 = system1.GetContainer(ComponentName="Model")
w(OUT, "model container ok")

payload = '''
p = r"C:\\Work\\ansys-automation\\logs\\setup-mech.txt"


def w(t):
    f = open(p, "a")
    try:
        f.write(str(t) + "\\n")
    finally:
        f.close()


import os
import traceback

w("mech start")
w("env ROOT=%r PROJ=%r STRUCTURE=%r EXEC=%r" % (
    os.environ.get("ANSYS_AUTOMATION_ROOT"),
    os.environ.get("ANSYS_AUTOMATION_PROJECT"),
    os.environ.get("STRUCTURE_ID"),
    os.environ.get("EXECUTION")))

# execfile не выставляет __file__: без этой строки ломается поиск пакета Mechanical.
__file__ = r"C:\\Work\\ansys-automation\\src\\Mechanical\\ansys_automation.py"

try:
    execfile(r"C:\\Work\\ansys-automation\\src\\Mechanical\\ansys_automation.py")
    w("setup OK")
except:
    w("setup FAILED:\\n" + traceback.format_exc())

try:
    w("connections=%r" % Model.Connections.Children.Count)
except:
    w("connections probe failed:\\n" + traceback.format_exc())

mesh = None
try:
    mesh = Model.Mesh
except:
    w("mesh probe failed:\\n" + traceback.format_exc())

if mesh is not None:
    for attr in ("Statistics", "Nodes", "Elements"):
        try:
            value = getattr(mesh, attr)
        except:
            continue
        w("mesh %s=%r" % (attr, value))

try:
    solution = Model.Analyses[0].Solution
    w("solution children=%r" % solution.Children.Count)
except:
    w("solution probe failed:\\n" + traceback.format_exc())

w("mech end")
'''

model1.SendCommand(Command=payload, Language="Python")
w(OUT, "setup sent")

deadline = time.time() + 1800
while time.time() < deadline:
    time.sleep(10)
    if os.path.exists(MECH):
        text = open(MECH).read()
        if "mech end" in text or "setup FAILED" in text:
            w(OUT, "setup finished")
            break
        w(OUT, "waiting: %d bytes" % len(text))

# Сохранить настроенный проект: без этого закрытие окна выбрасывает настройку.
try:
    project_path = os.environ.get("ANSYS_AUTOMATION_PROJECT", "")
    if project_path:
        Save(FilePath=project_path, Overwrite=True)
        w(OUT, "save ok: %s" % project_path)
    else:
        w(OUT, "save skipped: project path unknown")
except Exception:
    import traceback as _tb
    w(OUT, "save FAILED: " + _tb.format_exc())

w(OUT, "journal end")
