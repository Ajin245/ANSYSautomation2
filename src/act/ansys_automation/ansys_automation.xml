<?xml version="1.0" encoding="utf-8"?>
<!--
  ACT-расширение «ansys_automation» для Mechanical (ANSYS 21R1, каталог v211).

  Назначение: доставить наш конвейер в Mechanical вместо python-команды на
  контейнере Model (на сборке 21.1.0.2020110819 она молча ничего не делает —
  см. docs/run-modes.md).

  Расширение ничего не делает, пока не задана переменная окружения
  ANSYS_AUTOMATION_RUN=1: она ставится только из scripts/run_ansys.bat,
  поэтому установленное расширение не мешает обычной работе в Mechanical.

  Структура манифеста повторяет публичные ACT-расширения для Mechanical:
  <guid>, <script>, <interface context="Mechanical"> с колбэком <oninit>
  (см. docs/act-extension.md, раздел «Источники»).
-->
<extension version="1" minorversion="0" name="ansys_automation">
  <author>ansys-automation</author>
  <description>Запускает src/Mechanical/ansys_automation.py при старте Mechanical (ANSYS_AUTOMATION_RUN=1).</description>
  <guid shortid="ansAuto">01c84fd5-c565-4fa6-9798-73e532e5b65a</guid>
  <script src="ansys_automation_act.py"/>
  <interface context="Mechanical">
    <callbacks>
      <oninit>on_init</oninit>
    </callbacks>
  </interface>
</extension>
